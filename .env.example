# Go API
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://restaurant:restaurant@localhost:5433/restaurant?sslmode=disable
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
MIGRATIONS_DIR=migrations

# Configure these before enabling the related features.
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=24
AUTH_SECRET=
TLS_CERT_FILE=
TLS_KEY_FILE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Next.js (server-side only)
API_INTERNAL_URL=http://localhost:8080
